{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .codex/scripts/hooks/session_context_injector.py",
            "timeout": 10,
            "statusMessage": "Loading Andromeda session context"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .codex/scripts/hooks/user_prompt_scope_guard.py",
            "timeout": 10,
            "statusMessage": "Checking Andromeda prompt scope"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .codex/scripts/hooks/pre_tool_destructive_guard.py",
            "timeout": 10,
            "statusMessage": "Checking destructive command policy"
          },
          {
            "type": "command",
            "command": "python3 .codex/scripts/hooks/pre_tool_rust_guard.py",
            "timeout": 10,
            "statusMessage": "Checking Rust command policy"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .codex/scripts/hooks/pre_tool_destructive_guard.py",
            "timeout": 10,
            "statusMessage": "Checking write/edit safety"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .codex/scripts/hooks/permission_request_guard.py",
            "timeout": 10,
            "statusMessage": "Evaluating permission request policy"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .codex/scripts/hooks/post_tool_audit.py",
            "timeout": 10,
            "statusMessage": "Auditing tool result"
          },
          {
            "type": "command",
            "command": "python3 .codex/scripts/hooks/codex_tooling_audit.py",
            "timeout": 10,
            "statusMessage": "Checking Codex tooling impact"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .codex/scripts/hooks/stop_quality_gate.py",
            "timeout": 10,
            "statusMessage": "Running final quality gate"
          }
        ]
      }
    ]
  }
}
