{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .codex/scripts/hooks/session_start_context.py",
            "timeout": 10,
            "statusMessage": "Loading Andromeda Codex context"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .codex/scripts/hooks/user_prompt_submit_guard.py",
            "timeout": 10,
            "statusMessage": "Checking prompt against Andromeda guardrails"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python .codex/scripts/hooks/pre_tool_use_policy.py",
            "timeout": 10,
            "statusMessage": "Checking shell command policy"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python .codex/scripts/hooks/post_tool_use_audit.py",
            "timeout": 10,
            "statusMessage": "Recording shell command audit event"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .codex/scripts/hooks/pre_tool_use_policy.py",
            "timeout": 10,
            "statusMessage": "Checking permission request policy"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .codex/scripts/hooks/stop_quality_gate.py",
            "timeout": 10,
            "statusMessage": "Applying final Andromeda quality reminder"
          }
        ]
      }
    ]
  }
}
