{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Andromeda Agent Definition",
  "type": "object",
  "required": [
    "name",
    "mission",
    "tools",
    "primary_skills",
    "handoffs"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "mission": {
      "type": "string"
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "primary_skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "handoffs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
