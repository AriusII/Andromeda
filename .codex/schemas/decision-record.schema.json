{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Andromeda Decision Record",
  "type": "object",
  "required": [
    "title",
    "status",
    "context",
    "decision",
    "consequences",
    "validation_plan"
  ],
  "properties": {
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "context": {
      "type": "string"
    },
    "decision": {
      "type": "string"
    },
    "alternatives": {
      "type": "string"
    },
    "consequences": {
      "type": "string"
    },
    "affected_components": {
      "type": "string"
    },
    "validation_plan": {
      "type": "string"
    },
    "rollback_plan": {
      "type": "string"
    }
  }
}
