{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Andromeda Skill Manifest",
  "type": "object",
  "required": [
    "name",
    "description",
    "allowed_tools",
    "domain",
    "version"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "allowed_tools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "domain": {
      "type": "string"
    },
    "version": {
      "type": "string"
    }
  }
}
